<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titre }} | {{ site.nom }}</title>
<meta name="description" content="{{ description }}">
<meta name="color-scheme" content="light dark">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="preload" href="/assets/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/app.css">
<script src="/assets/js/app.js" defer></script>
</head>
<body data-section="{{ section }}">
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="topbar">
  <a class="brand" href="/">{{ site.nom }}</a>
  <nav class="nav" aria-label="Navigation principale">
    <a href="/"{% if section == "accueil" %} aria-current="page"{% endif %}>Accueil</a>
    <a href="/parcours/"{% if section == "parcours" %} aria-current="page"{% endif %}>Parcours</a>
    <a href="/explorer/"{% if section == "explorer" %} aria-current="page"{% endif %}>Explorer</a>
    <a href="/se-former/"{% if section == "formations" %} aria-current="page"{% endif %}>Se former</a>
  </nav>
</header>
<main id="contenu">
{{ content | safe }}
</main>
</body>
</html>
