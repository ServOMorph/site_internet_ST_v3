<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titre }} | {{ site.nom }}</title>
<meta name="description" content="{{ description }}">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#050d08">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/png" href="/assets/img/logo.png">
<link rel="preload" href="/assets/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/app.css">
</head>
<body data-section="{{ section }}">
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="topbar">
  <a class="brand" href="/">{{ site.nom }}</a>
  <nav class="nav" aria-label="Navigation principale">
    <a href="/"{% if section == "accueil" %} aria-current="page"{% endif %}>Accueil</a>
    <a href="/parcours/"{% if section == "parcours" %} aria-current="page"{% endif %}>Comprendre</a>
    <a href="/en-pratique/"{% if section == "en-pratique" %} aria-current="page"{% endif %}>En pratique</a>
    <a href="/quiz/"{% if section == "quiz" %} aria-current="page"{% endif %}>Quiz</a>
    <a href="/actualites/"{% if section == "actualites" %} aria-current="page"{% endif %}>Actualités</a>
    <a href="/evenements/"{% if section == "evenements" %} aria-current="page"{% endif %}>Événements</a>
  </nav>
</header>
<main id="contenu">
{{ content | safe }}
</main>
<footer class="pied">
  <a class="pied__logo" href="/"><img src="/assets/img/logo.webp" alt="{{ site.nom }}" width="200" height="200" loading="lazy"></a>
  <nav aria-label="Informations">
    <a href="/sources/">Sources et méthode</a>
    <a href="/glossaire/">Glossaire</a>
    <a href="/a-propos/">À propos</a>
    <a href="/a-propos/#contact">Contact</a>
    <a href="/se-former/">Se former</a>
  </nav>
  <p class="pied__note">Maquette : le poids de la page s'affichera ici.</p>
</footer>
</body>
</html>
